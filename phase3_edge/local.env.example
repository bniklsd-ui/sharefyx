# Vorlage für phase3_edge/local.env — lokale Maschinen-Konfiguration, NICHT im Repo (siehe
# .gitignore). install_units.sh liest local.env und ersetzt damit die sechs Platzhalter
# (__REPO_ROOT__, __DATA_ROOT__, __ALLOWED_HOSTS__, __VENV__, __AUTH_MODE__,
# __PUBLIC_BASE_URL__) in den systemd-Unit-Vorlagen unter phase3_edge/systemd/ UND
# phase4_auth/systemd/ (P4 Step 7: die MCP-Unit zog dorthin um). Kein Token, kein Geheimnis hier
# — nur Maschinenpfade und der öffentliche Hostname (der ohnehin in Certificate-Transparency-Logs
# steht, siehe Plan §0/§6).
#
# cp phase3_edge/local.env.example phase3_edge/local.env, dann die sechs Werte eintragen.

# Absoluter Pfad zu diesem Repo-Checkout auf der Ziel-VM. Bewusst kein Beispiel aus dieser
# Maschine (P3-J-Begründung ist Maschinenunabhängigkeit — ein Kollege oder eine zweite VM
# sollen dasselbe Repo benutzen können, nicht diese konkreten Pfade kopieren).
REPO_ROOT=/path/to/savefxy

# Absoluter Pfad zum echten Datenverzeichnis (SPACE_DATA_ROOT).
DATA_ROOT=/path/to/savefyx-data

# Absoluter Pfad zum venv-Python, das ExecStart benutzt (Step 0 C / V6: nicht das Symlink-Ziel,
# sondern der venv-Pfad selbst, z. B. <REPO_ROOT>/.venv).
VENV=/path/to/savefxy/.venv

# Kommagetrennte Liste erlaubter Hosts/Origins (SPACE_ALLOWED_HOSTS) — der stabile Funnel-
# Hostname aus Step 7, z. B. <node>.<tailnet>.ts.net. Leer lassen ist ein Fehler unter einem
# Dauerdienst hinter Funnel, nicht "sicherer".
ALLOWED_HOSTS=

# P4 Step 7: SPACE_AUTH_MODE — token/both/oauth. Während der Live-Abnahme auf "both" (Pfad-Token
# UND Bearer laufen parallel, nichts fällt aus, während die Abnahmematrix läuft), am Ende von
# Step 7 auf "oauth" gesetzt (der "Schnitt", Plan §5 Step 7 Punkt 8) — dann verschwindet der
# Pfad-Token endgültig.
AUTH_MODE=both

# P4 Step 7: SPACE_PUBLIC_BASE_URL — die öffentliche https://-Basis-URL des Servers (derselbe
# Tailscale-Funnel-Hostname wie ALLOWED_HOSTS, mit https:// davor, ohne trailende `/`), z. B.
# https://<node>.<tailnet>.ts.net. Pflicht sobald AUTH_MODE nicht "token" ist — der
# Authorization Server baut seine Discovery-/Redirect-URLs daraus (`authserver/config.py ::
# load_auth_settings()`).
PUBLIC_BASE_URL=
