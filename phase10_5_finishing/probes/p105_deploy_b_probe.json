  "update_log": {
    "eintraege": [
      {
        "id": "2026-10-23#2",
        "datum": "2026-10-23",
        "erste_zeile": "Die KI-Verbindung kann jetzt mehrere Notizen in einem einzigen Aufruf um Text ergänzen — jede Notiz bringt ihre eigene Version mit, ein Konflikt stoppt die anderen nicht."
      },
      {
        "id": "2026-10-23#1",
        "datum": "2026-10-23",
        "erste_zeile": "Die Übersicht lädt jetzt deutlich schneller: die Zähler kommen in einem einzigen Durchgang statt einzeln je Ordner und Space."
      },
      {
        "id": "2026-10-08#1",
        "datum": "2026-10-08",
        "erste_zeile": "Neue Notizen und Aufgaben landen jetzt in dem Space, in dem du gerade arbeitest — vorher wanderten sie aus einem Team-Space still in deinen eigenen. Der Anlegen-Dialog nennt oben das Ziel."
      },
      {
        "id": "2026-10-07#1",
        "datum": "2026-10-07",
        "erste_zeile": "Die Einstellungen sind jetzt eine Fensterkette: das Menü bleibt sichtbar, während das Passwort-, das Spaces- und das Update-Log-Fenster daneben aufgehen. Aus „Spaces verwalten\" öffnet ein Klick auf einen Space ein drittes Fenster."
      },
      {
        "id": "2026-10-03#1",
        "datum": "2026-10-03",
        "erste_zeile": "Die Kopfdaten haben ein neues Feld „Bei“: damit steht, wer eine Aufgabe übernommen hat. Setzt du den Status auf „In Arbeit“ und das Feld ist noch leer, trägt die Oberfläche deinen eigenen Space selbst ein."
      },
      {
        "id": "2026-10-02#1",
        "datum": "2026-10-02",
        "erste_zeile": "Aufgaben können jetzt den Status „In Arbeit\" bekommen und tauchen in einem eigenen Ordner „In Arbeit\" in der Navigation auf — vorher war eine so markierte Aufgabe in keinem einzigen Ordner mehr auffindbar."
      },
      {
        "id": "2026-09-18#1",
        "datum": "2026-09-18",
        "erste_zeile": "Die Übersicht zeigt deine Spaces jetzt direkt neben der Verknüpfungs-Karte statt darüber — beides auf einen Blick, kein Umschalten mehr nötig."
      },
      {
        "id": "2026-09-05#1",
        "datum": "2026-09-05",
        "erste_zeile": "Im Suchdialog für Verknüpfungen kannst du wählen, ob eine Notiz als Text-Link im Notiztext oder als Eintrag im Links-Feld angelegt wird — die letzte Wahl wird gemerkt."
      },
      {
        "id": "2026-09-02#1",
        "datum": "2026-09-02",
        "erste_zeile": "Die Übersicht ist jetzt tabellos: jede deiner Spaces bekommt eine eigene Zeile mit Zähler-Chips für „Offen\", „Erledigt\", „Notizen\" und „Archiv\" — ein Klick auf einen Chip öffnet die zugehörige Liste. Vier gleiche Kacheln gibt es nicht mehr."
      },
      {
        "id": "2026-09-01#2",
        "datum": "2026-09-01",
        "erste_zeile": "Links zwischen Notizen werden anklickbar: ein `#item/...`-Link im Text einer Notiz öffnet direkt das verlinkte Gegenstück — vorher waren die Links sichtbar, aber ohne Funktion."
      },
      {
        "id": "2026-09-01#1",
        "datum": "2026-09-01",
        "erste_zeile": "Claude nennt dir gegenüber jetzt den Titel einer Notiz statt einer internen ID — die Kennung bleibt im Hintergrund, der Titel ist, was du im Browser siehst."
      },
      {
        "id": "2026-08-31#1",
        "datum": "2026-08-31",
        "erste_zeile": "Mehrere Notizen gleichzeitig in einen anderen Space verschieben: reicht jetzt ein Passwort und ein Code für alle aus, auch wenn die Aktion Schreibrechte erweitert — der Code wird intern genau einmal verwendet, danach ist für jede weitere Verschiebe-Aktion ein neuer Code nötig."
      },
      {
        "id": "2026-08-27#1",
        "datum": "2026-08-27",
        "erste_zeile": "Neuer Menüpunkt \"Spaces verwalten\": eigene Spaces anlegen oder entfernen, Mitglieder mit Schreibrecht hinzufügen oder entfernen — direkt im Konto-Menü, ohne Kommandozeile."
      },
      {
        "id": "2026-08-25#1",
        "datum": "2026-08-25",
        "erste_zeile": "Neuer Knopf zum Entfernen von Bildern aus einer Notiz — das Bild wandert in den Papierkorb, die Textstelle bleibt als reiner Bildname stehen."
      },
      {
        "id": "2026-08-23#1",
        "datum": "2026-08-23",
        "erste_zeile": "Interner Aufräumschritt: jede bestehende Notiz trägt jetzt explizit \"privat\" in ihren Metadaten — das war schon vorher der geltende Standardwert, sichtbar ändert sich für dich nichts."
      },
      {
        "id": "2026-08-21#1",
        "datum": "2026-08-21",
        "erste_zeile": "Bilder in Notizen: hochladen, ansehen, im Text einfügen — direkt im Editor."
      },
      {
        "id": "2026-08-14#1",
        "datum": "2026-08-14",
        "erste_zeile": "Echte Ordner: anlegen und Notizen per Menü oder per Ziehen (Drag & Drop) hineinverschieben."
      },
      {
        "id": "2026-08-13#2",
        "datum": "2026-08-13",
        "erste_zeile": "Grauer Text (Platzhalter, Meta-Angaben, Versionsband) ist jetzt deutlich besser lesbar — Kontrast auf WCAG AA angehoben."
      },
      {
        "id": "2026-08-13#1",
        "datum": "2026-08-13",
        "erste_zeile": "Die angekündigte Umstellung ist jetzt live: fremde Spaces sind nicht mehr automatisch mitlesbar — nur noch, wo eine ausdrückliche Freigabe besteht."
      },
      {
        "id": "2026-08-09#1",
        "datum": "2026-08-09",
        "erste_zeile": "Deine Notizen werden bald **standardmäßig privat**: alles Bestehende und alles Neue ist nach der nächsten Umstellung nur noch für dich sichtbar."
      }
    ],
